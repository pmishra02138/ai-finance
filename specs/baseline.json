{
  "id": "baseline",
  "title": "1. Baseline & Triage",
  "subtitle": "Capture cash flow and net worth today",
  "modules": [
    {
      "name": "finance-budget",
      "label": "Cash Flow & Budget",
      "engine": "deterministic",
      "description": "Capture monthly take-home pay, 50/30/20 spending split, savings rate, and liquid cash runway as your single cash-flow baseline.",
      "fields": [
        {"key": "monthly_income", "label": "Monthly Take-Home Pay ($)", "type": "number", "default": 9200, "plan_path": "cash_flow.monthly_income"},
        {"key": "monthly_needs", "label": "Monthly Essential Needs ($)", "type": "number", "default": 4600},
        {"key": "monthly_wants", "label": "Monthly Discretionary Wants ($)", "type": "number", "default": 1600},
        {"key": "liquid_cash", "label": "Liquid Cash & Emergency Savings ($)", "type": "number", "default": 15000}
      ],
      "constants": {
        "needs_target_pct": 50.0,
        "wants_target_pct": 30.0,
        "savings_target_pct": 20.0,
        "target_emergency_months": 6.0
      }
    },
    {
      "name": "finance-networth",
      "label": "Net Worth Tracker",
      "engine": "deterministic",
      "description": "Calculate total assets, liabilities, and net worth against the Millionaire Next Door benchmark using gross annual income.",
      "fields": [
        {"key": "cash_assets", "label": "Cash & Liquid Savings ($)", "type": "number", "default": 15000},
        {"key": "investment_assets", "label": "Investments & Retirement ($)", "type": "number", "default": 184000, "plan_path": "investments.total_value"},
        {"key": "real_estate_assets", "label": "Real Estate Value ($)", "type": "number", "default": 0},
        {"key": "other_assets", "label": "Other Assets ($)", "type": "number", "default": 15000},
        {"key": "mortgage_debt", "label": "Mortgage Balance ($)", "type": "number", "default": 0},
        {"key": "other_debt", "label": "Other Debts ($)", "type": "number", "default": 41200, "plan_agg": "sum_debt"},
        {"key": "age", "label": "Current Age", "type": "number", "default": 38, "plan_path": "retirement.current_age"},
        {"key": "annual_income", "label": "Gross Annual Income (Pre-Tax, $)", "type": "number", "default": 145000, "plan_agg": "gross_annual_income"}
      ],
      "constants": {
        "milestones": [100000, 250000, 500000, 1000000, 5000000, 10000000]
      }
    }
  ]
}
