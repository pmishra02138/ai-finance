{
  "id": "foundation",
  "title": "2. Foundation & Defense",
  "subtitle": "Optimize cash flow, safety net, debt, and protection",
  "modules": [
    {
      "name": "finance-budget",
      "label": "Budget & Cash Flow",
      "engine": "deterministic",
      "description": "Analyze your monthly take-home pay and spending using the 50/30/20 framework to uncover extra savings.",
      "fields": [
        {"key": "monthly_income", "label": "Monthly Take-Home Pay ($)", "type": "number", "default": 9200, "plan_path": "cash_flow.monthly_income"},
        {"key": "monthly_needs", "label": "Monthly Essential Needs ($)", "type": "number", "default": 4600},
        {"key": "monthly_wants", "label": "Monthly Discretionary Wants ($)", "type": "number", "default": 1600}
      ],
      "constants": {
        "needs_target_pct": 50.0,
        "wants_target_pct": 30.0,
        "savings_target_pct": 20.0
      }
    },
    {
      "name": "finance-emergency",
      "label": "Emergency Fund",
      "engine": "deterministic",
      "description": "Determine your ideal emergency fund target in months of essential expenses and see how fast you can build it.",
      "fields": [
        {"key": "monthly_essential_expenses", "label": "Monthly Essential Expenses ($)", "type": "number", "default": 4000},
        {"key": "current_emergency_fund", "label": "Current Emergency Fund ($)", "type": "number", "default": 11000},
        {"key": "monthly_contribution", "label": "Monthly Addition ($)", "type": "number", "default": 500},
        {
          "key": "job_stability",
          "label": "Income Stability",
          "type": "select",
          "default": "stable",
          "options": [
            {"value": "stable", "label": "Stable W-2"},
            {"value": "variable", "label": "Variable / Commission"},
            {"value": "high_risk", "label": "High Volatility / Seasonal"}
          ]
        },
        {"key": "dependents", "label": "Dependents", "type": "number", "default": 1},
        {"key": "self_employed", "label": "Self-Employed / Business Owner", "type": "checkbox", "default": false}
      ],
      "constants": {
        "min_months": 3,
        "max_months": 12
      }
    },
    {
      "name": "finance-debt",
      "label": "Debt Payoff",
      "engine": "deterministic",
      "description": "Compare Avalanche vs. Snowball payoff strategies and separate high-APR consumer debt from low-APR fixed loans.",
      "fields": [
        {"key": "extra_monthly_payment", "label": "Extra Monthly Payment Toward Debt ($)", "type": "number", "default": 400},
        {
          "key": "accounts",
          "label": "Your Debt Accounts",
          "type": "debt_list",
          "plan_path": "debt.accounts",
          "default": [
            {"name": "Credit Card", "balance": 8400, "apr": 22.0, "min_payment": 220},
            {"name": "Student Loan", "balance": 18600, "apr": 6.2, "min_payment": 210}
          ]
        }
      ],
      "constants": {
        "max_months": 600,
        "high_apr_threshold": 7.0
      }
    },
    {
      "name": "finance-protection",
      "label": "Protection & Estate",
      "engine": "deterministic",
      "description": "Audit insurance coverage (term life, disability, health, umbrella) and estate documents (will, POA, beneficiaries) to score your Protection pillar.",
      "fields": [
        {
          "key": "term_life_status",
          "label": "Term Life Insurance",
          "type": "select",
          "default": "Good",
          "options": [
            {"value": "Good", "label": "Good (10-12x income or no dependents)"},
            {"value": "Partial", "label": "Partial (employer-only or underinsured)"},
            {"value": "Missing", "label": "Missing (needed for dependents)"}
          ]
        },
        {
          "key": "disability_status",
          "label": "Disability Insurance (LTD)",
          "type": "select",
          "default": "Partial",
          "options": [
            {"value": "Good", "label": "Good (60%+ own-occupation coverage)"},
            {"value": "Partial", "label": "Partial (basic employer policy only)"},
            {"value": "Missing", "label": "Missing (no disability coverage)"}
          ]
        },
        {
          "key": "health_status",
          "label": "Health Insurance",
          "type": "select",
          "default": "Good",
          "options": [
            {"value": "Good", "label": "Good (comprehensive or HDHP + HSA)"},
            {"value": "Partial", "label": "Partial (high out-of-pocket exposure)"},
            {"value": "Missing", "label": "Missing (uninsured)"}
          ]
        },
        {
          "key": "umbrella_status",
          "label": "Umbrella / Liability Coverage",
          "type": "select",
          "default": "Partial",
          "options": [
            {"value": "Good", "label": "Good ($1M+ umbrella or low exposure)"},
            {"value": "Partial", "label": "Partial (standard auto/home only)"},
            {"value": "Missing", "label": "Missing (high assets, no umbrella)"}
          ]
        },
        {
          "key": "estate_docs_status",
          "label": "Will, POA & Beneficiaries",
          "type": "select",
          "default": "Missing",
          "options": [
            {"value": "Good", "label": "Good (will, POA, directive & beneficiaries current)"},
            {"value": "Partial", "label": "Partial (beneficiaries set, no will/POA)"},
            {"value": "Missing", "label": "Missing (no estate documents)"}
          ]
        },
        {"key": "emergency_fund_months", "label": "Emergency Fund Coverage (Months)", "type": "number", "step": "0.5", "default": 4}
      ],
      "constants": {}
    }
  ]
}
