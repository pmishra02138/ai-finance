{
  "id": "horizons",
  "title": "4. Retirement & Goals",
  "subtitle": "Retirement, financial independence, goals, and scenario trade-offs",
  "modules": [
    {
      "name": "finance-retirement",
      "label": "Retirement & FI Planner",
      "pillar": "Retirement",
      "engine": "hybrid_monte_carlo",
      "description": "Unified retirement and Financial Independence (FIRE) planner: employer match, withdrawal taxes, Social Security timing, Lean/Regular/Fat/Coast FI targets, Safe Withdrawal Rate, and 1,000-trial log-normal Monte Carlo.",
      "fields": [
        {"key": "current_age", "label": "Current Age", "type": "number", "default": 38, "plan_path": "retirement.current_age"},
        {"key": "retirement_age", "label": "Target Retirement Age", "type": "number", "default": 65, "plan_path": "retirement.retirement_age"},
        {"key": "current_balance", "label": "Current Retirement Balance ($)", "type": "number", "default": 184000, "plan_path": "retirement.current_balance"},
        {"key": "monthly_contribution", "label": "Your Monthly Contribution ($)", "type": "number", "default": 920, "plan_path": "retirement.monthly_contribution"},
        {"key": "employer_match_monthly", "label": "Monthly Employer 401(k) Match ($)", "type": "number", "default": 300},
        {"key": "desired_annual_spending", "label": "Desired After-Tax Annual Spend ($)", "type": "number", "default": 58000},
        {"key": "withdrawal_rate", "label": "Safe Withdrawal Rate (SWR, %)", "type": "number", "step": "0.1", "default": 4.0},
        {"key": "retirement_tax_rate", "label": "Est. Effective Tax Rate on Withdrawals (%)", "type": "number", "step": "0.5", "default": 15.0},
        {"key": "social_security_annual", "label": "Expected Annual Social Security ($)", "type": "number", "default": 0},
        {"key": "social_security_start_age", "label": "Social Security Start Age", "type": "number", "default": 67}
      ],
      "constants": {
        "mc_trials": 1000,
        "mc_seed": 42,
        "mc_accum_return": 0.06,
        "mc_accum_vol": 0.14,
        "mc_retire_return": 0.045,
        "mc_retire_vol": 0.10,
        "drawdown_years": 30,
        "fire_horizon_years": 40
      }
    },
    {
      "name": "finance-goals",
      "label": "Goals & Trade-Off Scenarios",
      "engine": "hybrid_monte_carlo",
      "syncs_to_plan": false,
      "description": "Plan major milestones with 80% Monte Carlo confidence targets and compare two financial choices side-by-side (opportunity cost, ending equity, and win probability).",
      "fields": [
        {"key": "goal_name", "label": "Goal Name", "type": "text", "default": "House Down Payment"},
        {"key": "target_amount", "label": "Target Amount ($)", "type": "number", "default": 80000},
        {"key": "current_saved", "label": "Currently Saved ($)", "type": "number", "default": 20000},
        {"key": "years_to_goal", "label": "Years Until Goal", "type": "number", "step": "0.5", "default": 5},
        {"key": "expected_return", "label": "Expected Real Return (%)", "type": "number", "step": "0.1", "default": 4.5},
        {"key": "compare_enabled", "label": "Include Side-by-Side Trade-Off Comparison (A vs. B)", "type": "checkbox", "default": true},
        {"key": "scenario_a_name", "label": "Scenario A Name", "type": "text", "default": "Rent & Invest Difference"},
        {"key": "scenario_a_upfront", "label": "Scenario A Upfront Cost ($)", "type": "number", "default": 0},
        {"key": "scenario_a_monthly_cost", "label": "Scenario A Monthly Cost ($)", "type": "number", "default": 2400},
        {"key": "scenario_a_monthly_invest", "label": "Scenario A Monthly Invest ($)", "type": "number", "default": 800},
        {"key": "scenario_a_ending_asset", "label": "Scenario A Ending Asset Equity ($)", "type": "number", "default": 0},
        {"key": "scenario_b_name", "label": "Scenario B Name", "type": "text", "default": "Buy Home"},
        {"key": "scenario_b_upfront", "label": "Scenario B Upfront Cost ($)", "type": "number", "default": 60000},
        {"key": "scenario_b_monthly_cost", "label": "Scenario B Monthly Cost ($)", "type": "number", "default": 3200},
        {"key": "scenario_b_monthly_invest", "label": "Scenario B Monthly Invest ($)", "type": "number", "default": 0},
        {"key": "scenario_b_ending_asset", "label": "Scenario B Ending Asset Equity (e.g. Home Equity, $)", "type": "number", "default": 220000},
        {"key": "horizon_years", "label": "Comparison Horizon (Years)", "type": "number", "default": 10},
        {"key": "investment_return", "label": "Comparison Real Return (%)", "type": "number", "step": "0.1", "default": 6.5}
      ],
      "constants": {
        "mc_trials": 1000,
        "mc_seed": 42,
        "mc_volatility": 0.14
      }
    }
  ]
}
